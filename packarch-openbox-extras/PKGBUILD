# Scripts, dunst icons and artworks used by the Openbox configuration
# Files: files/ (installed as is). Most of the content was collected or made
# by Aditya Shakya (adi1090x), GPL3.

pkgname=packarch-openbox-extras
pkgver=2.0
pkgrel=3
pkgdesc="Scripts, dunst icons and artworks used by the Openbox configuration"
arch=('any')
url="https://github.com/Antidote1911/myrepo-pkgs"
license=('GPL3')
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
}
