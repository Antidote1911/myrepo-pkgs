#!/usr/bin/env bash
# Packarch in /etc/os-release and /etc/lsb-release, after cachyos-branding
# (cachyos-hooks), which writes CachyOS there. ID_LIKE keeps cachyos before
# arch: fastfetch then shows the logo of CachyOS. /etc/issue shows
# PRETTY_NAME.

update_os_release() {
    local os_release="/etc/os-release"
    [[ -e $os_release ]] || return 0
    sed -i "$os_release" \
        -e 's|^NAME=.*$|NAME="Packarch"|' \
        -e 's|^PRETTY_NAME=.*$|PRETTY_NAME="Packarch"|' \
        -e 's|^ID=.*$|ID=packarch|' \
        -e 's|^ID_LIKE=.*$|ID_LIKE="cachyos arch"|' \
        -e 's|^HOME_URL=.*$|HOME_URL="https://github.com/Antidote1911/CachyOS-Packarch"|' \
        -e 's|^SUPPORT_URL=.*$|SUPPORT_URL="https://github.com/Antidote1911/CachyOS-Packarch/issues"|' \
        -e 's|^BUG_REPORT_URL=.*$|BUG_REPORT_URL="https://github.com/Antidote1911/CachyOS-Packarch/issues"|' \
        -e 's|^LOGO=.*$|LOGO=org.packarch.hello|'
}

update_lsb_release() {
    local lsb_release="/etc/lsb-release"
    [[ -e $lsb_release ]] || return 0
    sed -i "$lsb_release" \
        -e 's|^DISTRIB_ID=.*$|DISTRIB_ID=packarch|' \
        -e 's|^DISTRIB_DESCRIPTION=.*$|DISTRIB_DESCRIPTION="Packarch"|'
}

# limine-entry-tool and limine-snapper-sync find the OS entry of limine.conf
# by the PRETTY_NAME of os-release when its machine-id comment is not under
# it (installations by Calamares before Packarch): the entry /+CachyOS is
# renamed, otherwise the next kernel update would add a second entry
# /+Packarch. limine.conf is enrolled again if enrollment is enabled (boot
# fails otherwise).
rename_limine_entry() {
    local esp conf
    [[ -r /etc/default/limine ]] || return 0
    esp=$(sed -n 's/^ESP_PATH="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/default/limine)
    conf="${esp:-/boot}/limine.conf"
    [[ -f $conf ]] && grep -qx '/+CachyOS' "$conf" || return 0
    sed -i 's|^/+CachyOS$|/+Packarch|' "$conf"
    if grep -qs '^ENABLE_ENROLL_LIMINE_CONFIG=yes' /etc/limine-entry-tool.conf /etc/default/limine &&
        command -v limine-enroll-config >/dev/null; then
        limine-enroll-config
    fi
}

update_os_release
update_lsb_release
rename_limine_entry
