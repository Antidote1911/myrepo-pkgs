# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# System settings of Packarch, common to the XFCE and Openbox desktops (they
# used to be copied by the ISO to the installed system):
# - no screen blanking from the X server, also on the login screen
#   (/usr/share/X11/xorg.conf.d)
# - numeric keypad on at the LightDM login screen (numlockx)
# - dark LightDM greeter: its own GTK theme Packarch-Greeter (GTK 3 of
#   Greybird-dark, 1.0-4: packarch-themes, the themes of the XFCE desktop, is
#   no longer needed by the Openbox desktop), Luna-Red-Dark icons, Qogir-Dark
#   cursor, wallpaper-alt.png background (lightdm-gtk-greeter.conf.d, read before
#   /etc/lightdm/lightdm-gtk-greeter.conf, whose settings are commented out)
# - pacman hooks, also run when this package is installed: Geany opens a new
#   instance each time (geany -i), useless entries hidden from the
#   application menus (packarch-hide-desktop-entries)
# - cachy-update: its systray applet starts with every session
#   (/etc/xdg/autostart of cachy-update) and the daily update check
#   (arch-update.timer) is enabled for every user
#   (/usr/lib/systemd/user/timers.target.wants)
# - Packarch in /etc/os-release and /etc/lsb-release (names, links, logo;
#   identifiers kept cachyos): pacman hook zz-packarch-branding, run after
#   the ones of cachyos-hooks that write CachyOS there (1.0-5)

pkgname=packarch-system-settings
pkgver=1.0
pkgrel=5
pkgdesc="System settings of Packarch (LightDM, X server, menu entries, cachy-update, os-release)"
arch=('any')
url="https://github.com/Antidote1911/myrepo-pkgs"
license=('GPL3')
depends=(sed numlockx qogir-icon-theme packarch-icons
         packarch-backgrounds cachy-update)
optdepends=(
  'lightdm-gtk-greeter: login screen using these settings'
)
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
}
