# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# Theme (skin) chooser of the Packarch Openbox desktop: applies the themes
# described by the theme.toml files of ~/.config/openbox/themes (see
# packarch-openbox). Source: skin/ (Rust). "render" (1.0.0-9) writes the
# default theme into the /etc/skel of packarch-openbox when it is built.
# "font" (1.0.0-11) stores the global fonts (themes/fonts.toml, the same for
# every theme) chosen with the pa-change-fonts menu of packarch-openbox.
# Role "fastfetch" (1.0.0-12): colors of fastfetch (logo, title, keys).

pkgname=packarch-skin
pkgver=1.0.0
pkgrel=12
pkgdesc="Theme (skin) chooser of the Packarch Openbox desktop"
arch=('x86_64')
url="https://github.com/Antidote1911/myrepo-pkgs"
license=('GPL3')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
options=(!lto)

prepare() {
	mkdir -p skin
	cp -a "$startdir"/skin/{Cargo.toml,Cargo.lock,src} skin/
	cd skin
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
	cd skin
	cargo build --frozen --release
}

check() {
	cd skin
	cargo test --frozen --release
}

package() {
	install -Dm755 skin/target/release/packarch-skin "$pkgdir"/usr/bin/packarch-skin
}
