<!DOCTYPE menu [
  <!ENTITY icons "/usr/share/packarch/openbox/icons/crayon">
  <!ENTITY pipes "/usr/share/packarch/openbox/pipemenus">
]>
<openbox_menu xmlns="http://openbox.org/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://openbox.org/  file:///usr/share/openbox/menu.xsd">
  <menu id="root-menu" title="Menu" label="Openbox 3">
<!--	<separator label="Menu principal"/>  -->
		<item icon="&icons;/terminal.png" label="Terminal">
			<action name="Execute">
				<command>alacritty</command>
			</action>
		</item>
		<separator/>
		<item icon="&icons;/filemanager.png" label="Gestionnaire de fichiers">
			<action name="Execute">
				<command>thunar</command>
			</action>
		</item>
		<separator/>
		<item icon="&icons;/browser.png" label="Navigateur web">
			<action name="Execute">
				<command>firefox</command>
			</action>
		</item>
		<separator/>
		<item icon="&icons;/editor.png" label="Éditeur de texte">
			<action name="Execute">
				<command>geany</command>
			</action>
		</item>
		<separator/>
		<separator/>
		<separator/>
		<menu icon="&icons;/apps.png" id="app-menu" execute="obmenu-generator" label="Applications"/>
		<separator/>
		<menu icon="&icons;/root.png" id="pa-asroot" execute="&pipes;/pa-asroot" label="Applications en root"/>
		<separator/>
		<menu icon="&icons;/shots.png" id="pa-shots" execute="&pipes;/pa-shots" label="Capture d’écran"/>
		<separator/>
		<menu icon="&icons;/record.png" id="pa-record" execute="&pipes;/pa-record" label="Enregistreur d’écran"/>
		<separator/>
		<separator/>
		<separator/>
		<menu icon="&icons;/places.png" id="pa-places" execute="&pipes;/pa-places --recent ~/" label="Emplacements"/>
		<separator/>
		<menu icon="&icons;/recents.png" id="ac-recent" execute="&pipes;/pa-recent-files" label="Fichiers récents"/>
		<separator/>
		<menu icon="&icons;/settings.png" id="preferences" label="Préférences">
			<menu id="obconfig" label="Openbox">
				<menu id="pa-ob-menu" execute="&pipes;/pa-ob-menu" label="Style du menu"/>
				<item label="Paramètres">
					<action name="Execute">
						<command>obconf</command>
					</action>
				</item>
				<separator/>
				<item label="Modifier menu.xml">
					<action name="Execute">
						<command>exo-open ~/.config/openbox/menu-icons.xml</command>
					</action>
				</item>
				<item label="Modifier rc.xml">
					<action name="Execute">
						<command>exo-open ~/.config/openbox/rc.xml</command>
					</action>
				</item>
				<item label="Modifier autostart">
					<action name="Execute">
						<command>exo-open ~/.config/openbox/autostart</command>
					</action>
				</item>
				<separator/>
				<item label="Recharger la configuration">
					<action name="Reconfigure"/>
				</item>
				<item label="Redémarrer Openbox">
					<action name="Restart"/>
				</item>
			</menu>
			<menu id="CompositingPipeMenu" execute="&pipes;/pa-compositor" label="Compositeur"/>
			<menu id="PanelPipeMenu" execute="&pipes;/pa-panel" label="Panneau / Barre"/>
			<menu id="XrandrPipeMenu" execute="&pipes;/pa-randr" label="Affichage / Écrans"/>
			<separator/>
			<menu id="StylePipeMenu" execute="packarch-skin openbox-menu" label="Changer de style"/>
			<menu id="FontPipeMenu" execute="&pipes;/pa-change-fonts" label="Changer de police"/>
			<menu id="SchemePipeMenu" execute="&pipes;/pa-change-scheme" label="Couleurs du terminal"/>
			<separator/>
			<item label="Recharger le thème">
				<action name="Execute">
					<command>packarch-reload-theme</command>
				</action>
			</item>
			<item label="Changer de fond d’écran">
				<action name="Execute">
					<command>nitrogen</command>
				</action>
			</item>
			<item label="Apparence">
				<action name="Execute">
					<command>xfce4-appearance-settings</command>
				</action>
			</item>
			<item label="Paramètres Qt5">
				<action name="Execute">
					<command>qt5ct</command>
				</action>
			</item>
			<item label="Paramètres Qt6">
				<action name="Execute">
					<command>qt6ct</command>
				</action>
			</item>
			<item label="Gestionnaire Kvantum">
				<action name="Execute">
					<command>kvantummanager</command>
				</action>
			</item>
			<separator/>
			<item label="Paramètres audio">
				<action name="Execute">
					<command>pavucontrol</command>
				</action>
			</item>
			<item label="Gestion de l’énergie">
				<action name="Execute">
					<command>xfce4-power-manager-settings</command>
				</action>
			</item>
			<item label="Gestionnaire de paramètres">
				<action name="Execute">
					<command>xfce4-settings-manager</command>
				</action>
			</item>
		</menu>
		<separator/>
		<menu icon="&icons;/keyboard.png" id="KeybindsPipeMenu" execute="&pipes;/pa-kb-pipemenu" label="Raccourcis clavier"/>
		<separator/>
		<separator/>
		<separator/>
		<item icon="&icons;/sys-lock.png" label="Verrouiller l’écran">
			<action name="Execute">
				<command>betterlockscreen --lock</command>
			</action>
		</item>
		<separator/>
		<menu icon="&icons;/sys-poweroff.png" id="Exit" label="Système">
			<menu icon="&icons;/stats.png" id="SystemPipeMenu" execute="&pipes;/pa-sysinfo" label="Infos système"/>
			<separator/>
			<item icon="&icons;/sys-exit.png" label="Se déconnecter">
				<action name="Execute">
					<command>&pipes;/pa-powermenu --logout</command>
				</action>
			</item>
			<separator/>
			<item icon="&icons;/sys-sleep.png" label="Mettre en veille">
				<action name="Execute">
					<command>&pipes;/pa-powermenu --suspend</command>
				</action>
			</item>
			<separator/>
			<item icon="&icons;/sys-reboot.png" label="Redémarrer">
				<action name="Execute">
					<command>&pipes;/pa-powermenu --reboot</command>
				</action>
			</item>
			<separator/>
			<item icon="&icons;/sys-poweroff-alt.png" label="Éteindre">
				<action name="Execute">
					<command>&pipes;/pa-powermenu --shutdown</command>
				</action>
			</item>
		</menu>
	</menu>
</openbox_menu>
<!-- vim:sw=2
-->
