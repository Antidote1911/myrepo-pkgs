## Openbox Pipemenu to open applications as root

# Variables and functions
MENUS_LIBDIR='/usr/share/packarch/openbox/menulib'
if ! . "$MENUS_LIBDIR/packarch.cfg" 2> /dev/null; then
	echo "Error: Failed to locate packarch.cfg in $MENUS_LIBDIR" >&2
	exit 1
fi

# cmd
root_cmd="$HOME/.config/openbox/scripts/ob-asroot"

# menu
menuStart
	menuItem 'Terminal (alacritty)' "$root_cmd 'alacritty'"
	menuItem 'Gestionnaire de fichiers (thunar)' "$root_cmd 'dbus-run-session thunar'"
	menuItem 'Éditeur de texte (geany)' "$root_cmd 'geany'"
	menuSeparator
	menuItem 'Gestionnaire de fichiers en console (ranger)' "$root_cmd 'alacritty -e ranger'"
	menuItem 'Éditeur de texte en console (vim)' "$root_cmd 'alacritty -e vim'"
	menuSeparator
	menuItem 'Paramètres Qt5' "$root_cmd 'qt5ct'"
	menuItem 'Paramètres Qt6' "$root_cmd 'qt6ct'"
	menuItem 'Gestionnaire Kvantum' "$root_cmd 'kvantummanager'"
menuEnd
