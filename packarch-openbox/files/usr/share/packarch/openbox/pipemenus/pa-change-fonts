## Openbox Pipemenu to change fonts for various applications. The fonts are
## global (~/.config/openbox/themes/fonts.toml, the same for every theme):
## packarch-skin font stores and applies them.

# Variables and functions
MENUS_LIBDIR='/usr/share/packarch/openbox/menulib'
if ! . "$MENUS_LIBDIR/packarch.cfg" 2> /dev/null; then
	echo "Error: Failed to locate packarch.cfg in $MENUS_LIBDIR" >&2
	exit 1
fi

# Font selector, opened on the font currently used by TARGET
getfonts () {
	local current
	current="$(packarch-skin font "$1" 2> /dev/null)"
	FONT=$(yad --title='Choisir une police' --font --separate-output ${current:+--fontname="$current"} --button=Annuler:1 --button=Choisir:0)
	[[ "$FONT" ]] || exit 0
	FNAME=$(echo $FONT | cut -d'|' -f1)
	FSTYLE=$(echo $FONT | cut -d'|' -f2)
	FSIZE=$(echo $FONT | cut -d'|' -f3)
}

# Stores and applies the chosen font for each TARGET
setfonts () {
	local target
	for target in "$@"; do
		packarch-skin font "$target" "$FNAME" "$FSTYLE" "$FSIZE"
	done
}

case "$1" in
	--bar)      getfonts polybar;  setfonts polybar ;;
	--rofi)     getfonts rofi;     setfonts rofi ;;
	--terminal) getfonts terminal; setfonts terminal ;;
	--openbox)  getfonts openbox;  setfonts openbox ;;
	--dunst)    getfonts dunst;    setfonts dunst ;;
	--gtk)      getfonts gtk;      setfonts gtk ;;
	--all)
		getfonts gtk
		setfonts polybar rofi terminal openbox dunst gtk
		;;
	*)
		menuStart
		menuItem 'Barre d’état (polybar)' "$0 --bar"
		menuItem 'Lanceurs (rofi)' "$0 --rofi"
		menuItem 'Terminal (kitty)' "$0 --terminal"
		menuItem 'Bureau (openbox)' "$0 --openbox"
		menuItem 'Notifications (dunst)' "$0 --dunst"
		menuItem 'Applications (gtk)' "$0 --gtk"
		menuSeparator
		menuItem 'Changer partout' "$0 --all"
		menuEnd
		;;
esac

exit 0
