## Openbox Pipemenu to start/stop the bar (polybar)

# Variables and functions
MENUS_LIBDIR='/usr/share/packarch/openbox/menulib'
if ! . "$MENUS_LIBDIR/packarch.cfg" 2> /dev/null; then
	echo "Error: Failed to locate packarch.cfg in $MENUS_LIBDIR" >&2
	exit 1
fi

# Generate menu
gen_menu () {
	menuStart
	if [[ `pidof polybar` ]]; then
		menuSeparator "Polybar : lancée"
		menuItem "Relancer Polybar" "packarch-skin bar"
		menuItem "Arrêter Polybar" "pkill polybar"
	else
		menuSeparator "Polybar : arrêtée"
		menuItem "Lancer Polybar" "packarch-skin bar"
	fi
	menuEnd
}

{ gen_menu; exit 0; }
