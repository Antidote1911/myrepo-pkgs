# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# Openbox configuration of Packarch: polybar, rofi menus, dunst, plank,
# picom, kitty and 15 themes, switched with packarch-skin. Based on the
# Openbox configuration of Aditya Shakya (adi1090x), GPL3, with the skeleton
# files it relies on (dunst, picom, rofi, GTK, xfconf, Thunar) and the Geany
# color schemes. Everything goes to /etc/skel (copied to the home of new
# users); the theme is applied at the first login (autostart).
#
# Our changes: French translation, 24-hour clock, numlock on, first-login theme
# application, no second xfce-polkit, Packarch names and paths
# (/usr/share/packarch, packarch-* commands, pa-* pipemenus), themes
# described in theme.toml and applied by packarch-skin (no apply.sh), kitty
# as the only terminal, no tint2.

pkgname=packarch-openbox
pkgver=7.0
pkgrel=15
pkgdesc="Openbox configuration of Packarch"
arch=('any')
url="https://github.com/Antidote1911/myrepo-pkgs"
license=('GPL3')
depends=(
  # Openbox and the tools of the configuration
  openbox obconf-qt obmenu-generator perl-linux-desktopfiles pulsemixer light
  polybar rofi dunst nitrogen plank xfce4-settings xmlstarlet
  python-lxml lead-git skippy-xd-git
  # optional dependencies used by the configuration (keys, menus, scripts)
  kitty thunar geany firefox viewnior betterlockscreen
  ksuperkey networkmanager-dmenu-git mpd mpc ffmpeg maim xclip xcolor
  xfce4-power-manager xorg-xsetroot yad picom
  # commands of the scripts and polybar modules
  xdotool wmctrl xorg-xprop xorg-xrandr xorg-xkill xorg-xbacklight acpi bc
  alsa-utils bluez-utils playerctl imagemagick ranger htop xfce-polkit
  xdg-user-dirs python-pyxdg dconf
  # Packarch repository: theme chooser, GTK/Openbox themes, icons, cursors,
  # fonts, wallpapers, scripts and dunst icons
  packarch-skin packarch-themes packarch-icons packarch-cursors
  packarch-fonts packarch-backgrounds packarch-openbox-extras
)
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
}
