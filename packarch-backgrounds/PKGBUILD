# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# Wallpapers of the XFCE desktop: those of the theme switcher, xfce-default.png
# and wallpaper-alt.png (LightDM greeter). Since 2.0-5, the other ones are in
# packarch-backgrounds-openbox, so that the XFCE live ISO does not ship them.
# Files: files/ (installed as is). Most of the content was collected or made
# by Aditya Shakya (adi1090x), GPL3.

pkgname=packarch-backgrounds
pkgver=2.0
pkgrel=5
pkgdesc="Wallpapers of the XFCE desktop of Packarch"
arch=('any')
url="https://github.com/packarch/myrepo-pkgs"
license=('GPL3')
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
}
