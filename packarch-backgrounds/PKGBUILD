pkgname=packarch-backgrounds
pkgver=2.0
pkgrel=3
pkgdesc="Wallpapers for Packarch (all of them, also those of the XFCE theme switcher)"
arch=('any')
url="https://github.com/Antidote1911/myrepo-pkgs"
license=('GPL3')
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
}
