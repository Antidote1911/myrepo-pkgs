# Maintainer: Fabrice Corraire <antidote1911@gmail.com>

pkgname=packarch-pi
pkgver=1.0.0
pkgrel=1
pkgdesc="Package installer for Packarch (fork of CachyOS Package Installer)"
arch=('x86_64')
url="https://github.com/Antidote1911/packarch-pi"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-translations' 'polkit')
makedepends=('cmake' 'ninja' 'git' 'polkit-qt6' 'qt6-tools' 'cargo' 'lld' 'clang' 'llvm')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Antidote1911/${pkgname}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

# Same LLVM toolchain as CachyOS (the Rust backend is linked with lld)
_toolchain() {
  export AR=llvm-ar CC=clang CXX=clang++ NM=llvm-nm RANLIB=llvm-ranlib
  export RUSTFLAGS="-Cembed-bitcode -C opt-level=3 -Ccodegen-units=1 -Clinker=clang -C link-arg=-flto -Clink-arg=-fuse-ld=/usr/bin/ld.lld"
}

build() {
  cd "$pkgname-$pkgver"
  _toolchain
  cmake -S . -Bbuild -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib
  cmake --build build --parallel
}

package() {
  cd "$pkgname-$pkgver"
  _toolchain
  DESTDIR="$pkgdir" cmake --build build --target install
}
