# Maintainer: Fabrice Corraire <antidote1911@gmail.com>

pkgname=packarch-rmatrix
pkgver=2.0.2.r7
pkgrel=1
pkgdesc="Rust port of a curses-based 'Matrix'-like screen"
arch=('x86_64')
url="https://github.com/Antidote1911/rmatrix"
license=('GPL3')
provides=("rmatrix")
makedepends=('git' 'cargo')
conflicts=('rmatrix')
source=("$pkgname::git+https://github.com/Antidote1911/rmatrix")
sha1sums=('SKIP')

build() {
  cd "$pkgname"
  cargo build --release
}

pkgver() {
  cd "$pkgname"
  # Crate version, then the number of commits
  printf "%s.r%s" "$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)" \
    "$(git rev-list --count HEAD)"
}

package() {
  cd "$pkgname"
  # The crate is named r-matrix: the command stays rmatrix
  install -Dm755 "target/release/r-matrix" "$pkgdir/usr/bin/rmatrix"
}
