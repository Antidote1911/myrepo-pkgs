# Maintainer: Fabrice Corraire <antidote1911@gmail.com>

pkgname=packarch-rmatrix
_name=rmatrix
pkgver=3.0.0
pkgrel=1
pkgdesc="Rust port of a curses-based 'Matrix'-like screen"
arch=('x86_64')
url="https://github.com/Antidote1911/rmatrix"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
provides=("rmatrix")
conflicts=('rmatrix')
source=("$_name-$pkgver.tar.gz::https://github.com/Antidote1911/${_name}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

check() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --release --frozen
}

package() {
  cd "$_name-$pkgver"
  # The crate is named r-matrix: the command stays rmatrix
  install -Dm755 "target/release/r-matrix" "$pkgdir/usr/bin/rmatrix"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
