pkgname=packarch-cursors
pkgver=2.0
pkgrel=2
pkgdesc="Cursor themes for Packarch (all of them)"
arch=('any')
url="https://github.com/Antidote1911/myrepo-pkgs"
license=('GPL3')
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
}
